package wirt:plugin@0.3.0;

interface host {
    // Logging
    enum log-level {
        trace,
        debug,
        info,
        warn,
        error
    }
    
    // Per-entry, rate, and retained-byte limits are enforced by the host.
    // Admitted warn/error entries also reach application tracing; lower levels
    // remain in the per-plugin file log.
    log: func(level: log-level, message: string);
    log-network-activity: func(message: string);
    
    // Settings
    get-setting: func(key: string) -> option<string>;
    // Settings are limited per plugin to 128 entries, 128-byte keys,
    // 64-KiB values, and 1 MiB aggregate retained text. Over-limit writes
    // are ignored; updates that remain within the limits are accepted.
    set-setting: func(key: string, value: string);

    // === Data API (unified) ===
    // Plugin requests data, host handles resolution transparently.
    // Sources are tried in order (waterfall pattern).

    // Data source types
    enum data-source {
        metadata-cache,  // Structured metadata; archive_metadata_read
        content-cache,   // Cached blobs; file_read (metadata also needs archive_metadata_read)
        local-file,      // File reads; file_read
        memory,          // In-memory ephemeral
        network,         // HTTP fetch; network
    }

    record data-request {
        key: string,                    // Unique identifier for this resource
        url: option<string>,            // Source URL (required if network in sources)
        resource-type: resource-type,
        product-id: option<string>,     // For organization
        sources: list<data-source>,     // Resolution chain (empty = default)
    }

    enum resource-type {
        image,
        json,
        binary,
    }

    enum data-status {
        pending,
        fetching,
        ready,
        failed,
        cached,  // Already had it
    }

    record data-result {
        status: data-status,
        data: option<list<u8>>,
        error: option<string>,
    }


    // Request data under the source capabilities above. Disallowed sources
    // are omitted; a request with no authorized source fails closed. Network
    // write-back requires archive_metadata_write for MetadataCache and
    // file_write for ContentCache. ContentCache entries are namespaced to the
    // calling plugin id and are invisible to the host and other plugins.
    // Guest-returned bodies are capped at 4 MiB.
    request-data: func(request: data-request) -> string;  // returns request-id

    // Poll for data status/result
    poll-data: func(request-id: string) -> data-result;

    // Check if data exists. ContentCache requires file_read; structured and
    // raw :json:/:html:/:metadata: metadata keys also require
    // archive_metadata_read regardless of the declared resource type. Marker
    // matching is ASCII-case-insensitive and does not percent-decode keys.
    has-data: func(key: string) -> bool;

    // Get data from storage under the same read policy; maximum 4 MiB.
    get-data: func(key: string) -> option<list<u8>>;

    // Fetch a URL through the host's data service and store it in
    // the appropriate cache, *without* returning the bytes to the
    // plugin. Designed for large blobs (videos, full archives) where
    // shipping the body across the WASM ABI boundary would waste
    // memory and copy work — the bytes never enter the plugin's
    // sandbox. Requires network + file_write. Metadata JSON or raw metadata
    // cache keys additionally require archive_metadata_write. Returns true on
    // success, false on denial or any failure.
    //
    // Equivalent to `request-data` + a discarded `poll-data`, but the
    // plugin doesn't pay for the cross-boundary copy. Storage is keyed
    // by `request.key`; subsequent `has-data` / `get-data` see the
    // cached entry the same way they would for `request-data`.
    fetch-to-cache: func(request: data-request) -> bool;

    // Reserved ABI for a future host-UI-authorized cached-blob launch.
    // Background plugin calls currently fail closed with
    // "external launch disabled: host UI authorization required";
    // the host never writes or launches the blob. `file_read` is still
    // required before this stable denial is returned. `extension` is
    // retained for ABI compatibility and is not acted upon.
    play-cached-blob: func(key: string, extension: string) -> result<_, string>;

    // Delete a content-cache entry, or entries matching a trailing '*'
    // pattern in the calling plugin's private cache namespace. Exact ordinary
    // keys require `file_write`; every wildcard and every exact raw metadata
    // key additionally requires `archive_metadata_write`. Denied calls return
    // false. Host-owned and other-plugin entries, and product metadata
    // records, are unaffected.
    invalidate-cache: func(key: string) -> bool;

    // Persist one ordinary content-cache value in the calling plugin's
    // private owner namespace. All three methods require `file_write`.
    // Keys/prefixes are UTF-8, at most 512 bytes, and may not be path-like,
    // wildcarded, or address the reserved raw metadata key families. Values
    // are capped at 4 MiB. The existing owner cache quota remains the total
    // storage ceiling.
    put-data: func(key: string, data: list<u8>) -> result<_, string>;
    data-key-count: func(prefix: string) -> result<u64, string>;
    // `limit` must be at most 256; returned key text is capped at 1 MiB.
    list-data-keys-page: func(prefix: string, offset: u32, limit: u32) -> result<list<string>, string>;



    // Archive Context
    record archive-info {
        path: string,
        filename: string,
    }
    // All archive-context reads require archive_metadata_read. The legacy
    // list returns only the first bounded page; use count + page for complete
    // traversal without one unbounded guest allocation.
    current-archive-info: func() -> option<archive-info>;
    list-archive-files: func() -> result<list<string>, string>;
    archive-file-count: func() -> result<u64, string>;
    // `limit` must be at most 256; returned path text is capped at 1 MiB.
    list-archive-files-page: func(offset: u32, limit: u32) -> result<list<string>, string>;

    /// Rename the currently open archive file
    /// Takes a new filename (not full path) and returns the new full path on success
    /// Requires ArchiveModify capability
    rename-archive: func(new-name: string) -> result<string, string>;

    // Metadata
    // Legacy compatibility import. The source is read from the JSON payload;
    // payloads without a source retain the historical DLSite default. New
    // plugins should use emit-metadata-for-source.
    emit-metadata: func(metadata-json: string);
    // Requires archive_metadata_write. Source and product-id are each capped
    // at 256 bytes, JSON at 4 MiB. The payload source must match `source`.
    // Per-plugin rate, distinct-ID and session-byte quotas are enforced, and
    // the host records plugin provenance in the persisted metadata extras.
    emit-metadata-for-source: func(source: string, metadata-json: string) -> bool;

    // Deprecated compatibility ABI. Admitted messages are written only to the
    // bounded plugin log; no host dialog is opened or retained.
    show-message: func(title: string, message: string);

    // Deprecated compatibility ABI. This is a no-op; the host retains no
    // guest string. Plugins should return UI actions or use bounded logging.
    set-status-message: func(message: string);

    // Legacy DLSite-only compatibility listing. Returns only the first
    // bounded page. New plugins should use the source-explicit APIs below.
    list-cached-entries: func() -> list<string>;
    cached-metadata-count: func(source: string) -> result<u64, string>;
    // `limit` must be at most 256. The database applies offset and limit;
    // returned external IDs share a 1 MiB text budget.
    list-cached-metadata: func(source: string, offset: u32, limit: u32) -> result<list<string>, string>;
    
    // Batch metadata summary for fast list rendering
    record metadata-summary {
        id: string,
        title: option<string>,
        geo-blocked: bool,
    }
    // Accepts at most 256 ids, each at most 256 bytes. Oversized batches are
    // rejected before database access. The query projects only id, a bounded
    // title, and geo-blocked; returned strings share a 1 MiB budget.
    get-metadata-summaries: func(ids: list<string>) -> list<metadata-summary>;
    // Source-explicit summary lookup. The source and every ID are bounded;
    // invalid inputs return an error before database access.
    get-metadata-summaries-for-source: func(source: string, ids: list<string>) -> result<list<metadata-summary>, string>;

    // Get full product metadata (maximum 4 MiB). product-id and source are each
    // capped at 256 bytes. Resolution order is local database, calling
    // plugin's JSON/HTML cache, then Gameta. Local database reads require
    // archive_metadata_read; cached JSON/HTML additionally require file_read;
    // Gameta additionally requires network and consumes one manifest request
    // budget permit per actual HTTP request. Cache repair/migration persists
    // only with archive_metadata_write.
    get-product-metadata: func(product-id: string, source: string) -> option<string>;

    // Create a file in private temporary storage owned by this plugin
    // instance. Requires `file_write`. `filename` is a sanitized hint;
    // the host chooses a collision-safe name with create-new semantics.
    // Storage is created lazily, limited to 128 files and 64 MiB total,
    // and removed when the plugin instance unloads. Returns the full path.
    create-file: func(filename: string, content: list<u8>) -> result<string, string>;
}

interface ui {
    // Button actions (declarative navigation)
    variant button-action {
        none,
        show-dialog(string),
        close-dialog,
        open-page(string),
        close-page,
        custom(string),
    }

    // What a piece of text IS, not how large it is. The host owns the type
    // scale, so restyling moves every label at once.
    enum text-role {
        title,
        subtitle,
        body,
        caption,
        emphasis,
    }

    // UI Element configs
    record label-config {
        text: string,
        role: text-role,
    }

    // Section header for semantic title hierarchy (like h1-h4)
    record section-header-config {
        title: string,
        level: u32,                    // 1=largest (h1), 4=smallest (h4)
        description: option<string>,   // Optional subtitle/description
    }

    record button-config {
        id: string,
        label: string,
        action: option<button-action>,
    }
    
    record text-input-config {
        id: string,
        label: string,
        value: string,
        placeholder: option<string>,  // If set, renders as simple input with placeholder (no label title)
    }
    
    record checkbox-config {
        id: string,
        label: string,
        checked: bool,
    }

    record radio-group-config {
        id: string,
        label: string,
        options: list<string>,
        selected: string,
    }

    record slider-config {
        id: string,
        label: string,
        value: f32,
        min: f32,
        max: f32,
        step: option<f32>,
    }

    record dropdown-config {
        id: string,
        label: string,
        options: list<string>,
        selected: string,
    }

    // New: Image config
    record image-config {
        cache-key: option<string>,
        url: option<string>,
        max-height: option<f32>,
    }

    // Tabs for view switching
    record tabs-config {
        id: string,
        tabs: list<string>,
        selected: string,
    }

    // Single list item (card-like display)
    record list-item-config {
        id: string,
        title: string,
        subtitle: option<string>,
        badge: option<string>,
        image-key: option<string>,      // Cache key to lookup/store the image
        image-url: option<string>,      // URL to fetch if not in cache
        selected: bool,
        warning-icon: option<warning-icon>,  // Optional warning indicator
    }

    // Scrollable list container
    record list-container-config {
        id: string,
        items: list<list-item-config>,
        max-height: option<f32>,
        empty-message: option<string>,
    }

    // Loading indicator
    record loading-config {
        message: option<string>,
    }

    // Warning / Alert banner
    enum warning-icon {
        warning,
        globe-x,
    }

    record warning-config {
        icon: warning-icon,
        message: string,
    }

    // Tag chips for displaying tags as styled pills
    record tag-chips-config {
        tags: list<string>,
        max-display: option<u32>,  // Limit visible tags (show "+N more")
    }

    // Toolbar button for plugin pages
    record toolbar-button-config {
        id: string,
        label: string,
        icon: option<string>,      // Optional icon name
        primary: bool,             // Primary/accent styling
        spacer-before: bool,       // Add flexible space before this button
    }

    // Toolbar for plugin pages
    record toolbar-config {
        buttons: list<toolbar-button-config>,
    }

    // Carousel gallery with thumbnail strip
    record carousel-config {
        id: string,
        images: list<tuple<string, option<string>>>,  // (cache_key, optional_url)
        current-index: u32,
        max-height: option<f32>,
        thumbnail-height: option<f32>,
        enable-lightbox: bool,
    }

    // Key-value pair for metadata display
    record key-value-pair {
        key: string,
        value: string,
    }

    // Key-value list for displaying metadata in a two-column grid (label: value)
    record key-value-list-config {
        items: list<key-value-pair>,
        columns: option<u32>,  // Number of key-value pairs per row (default: 1)
    }

    // Metadata grid for displaying key-value metadata in card format (label above value)
    record metadata-grid-config {
        items: list<key-value-pair>,
        columns: option<u32>,  // Number of columns (default: auto-fit based on available width)
    }

    // How much room a plugin wants between two elements. The host owns the
    // pixel value for each step, so a density change moves every gap at once.
    enum spacing-step {
        small,
        medium,
        large,
    }

    // UI Element variant (Leaf nodes and simple containers)
    variant ui-element {
        label(label-config),
        section-header(section-header-config),
        button(button-config),
        text-input(text-input-config),
        checkbox(checkbox-config),
        radio-group(radio-group-config),
        slider(slider-config),
        dropdown(dropdown-config),
        separator,
        space(spacing-step),
        image(image-config),
        tabs(tabs-config),
        list-container(list-container-config),
        loading(loading-config),
        warning(warning-config),
        tag-chips(tag-chips-config),
        toolbar(toolbar-config),
        carousel(carousel-config),
        key-value-list(key-value-list-config),
        metadata-grid(metadata-grid-config),
        // Visually-grouped settings section. The plugin emits a `group-begin`
        // followed by ordinary elements, then `group-end`. The host wraps
        // everything between the markers in a Form/SettingsGroup container so
        // plugin-supplied panels match the rest of the app.
        group-begin(settings-group-header),
        group-end,
    }

    // Title + optional description for a settings group, paired with
    // group-begin. group-end has no payload.
    record settings-group-header {
        title: string,
        description: option<string>,
    }

    // Top-level layout structure
    record split-config {
        sidebar: list<ui-element>,
        content: list<ui-element>,
        sidebar-width: option<f32>,
    }

    variant plugin-layout {
        single(list<ui-element>),
        split(split-config),
    }

    // === Top Tab Registration ===
    // Plugins can register top-level tabs in the app

    // Badge configuration for tabs
    record badge-config {
        count: option<u32>,      // Numeric badge (e.g., "3")
        dot: bool,               // Just a dot indicator
        color: string,           // "red", "green", "blue"
    }

    // Top-level tab configuration
    record top-tab-config {
        id: string,              // Unique tab identifier
        label: string,           // Display label
        icon: string,            // Emoji or icon string
        badge: option<badge-config>,
        priority: u32,           // Lower = more left (0-100 reserved for host)
    }

    // Plugin actions (returned from on-ui-event)
    enum toast-level {
        info,
        success,
        warning,
        error,
    }

    record toast-config {
        message: string,
        level: toast-level,
    }

    // Open lightbox with images
    record open-lightbox-config {
        images: list<tuple<string, option<string>>>,  // (cache_key, optional_url)
        start-index: u32,
        title: option<string>,
    }

    variant plugin-action {
        none,
        // Notification actions
        show-toast(toast-config),
        // UI update actions
        refresh-panel(string),
        // Navigation actions
        close-dialog,
        // Clipboard actions
        copy-to-clipboard(string),
        // Lightbox actions
        open-lightbox(open-lightbox-config),
        // Page display name (for breadcrumbs/title)
        set-page-display-name(string),
        // Request async background fetch (host handles on tokio runtime)
        // Format: "source:id" e.g. "dlsite:RJ123456"
        request-fetch(string),
    }
}

interface rules {
    record move-file-rule {
        pattern: string,
        target: string,
    }

    record move-rule {
        target-dir: string,
        use-date: bool,
        use-category: bool,
    }

    record plugin-rule-trigger {
        filename-pattern: option<string>,
        has-file: option<string>,
        extensions: option<list<string>>,
        min-size: option<u64>,
        max-size: option<u64>,
        metadata-source: option<string>,
    }

    record plugin-rule-actions {
        root-folder: option<string>,
        move-files: list<move-file-rule>,
        move-to: option<move-rule>,
        rename-pattern: option<string>,
        organize-content: bool,
        delete-original: bool,
        use-standard-layout: bool,
    }

    record plugin-rule-definition {
        name: string,
        category: string,
        description: option<string>,
        trigger: plugin-rule-trigger,
        actions: plugin-rule-actions,
    }
}

// Plugin self-description. Plugins implement `get-metadata` so the host can
// populate the plugin manager UI and verify that every identity field exactly
// matches the approved package manifest before initialization.
interface meta {
    record plugin-metadata {
        id: string,
        name: string,
        version: string,
        author: string,
        description: string,
    }
}

world plugin-world {
    import host;

    // Plugin exports
    export init: func();
    use rules.{plugin-rule-definition};
    export get-default-rules: func() -> list<plugin-rule-definition>;

    // UI exports
    use ui.{ui-element, plugin-action, top-tab-config, plugin-layout};
    export get-ui-layout: func(extension-point: string) -> plugin-layout;
    export on-ui-event: func(id: string, value: option<string>) -> list<plugin-action>;

    // Top Tab registration
    export get-top-tabs: func() -> list<top-tab-config>;

    // Self-description.
    use meta.{plugin-metadata};
    export get-metadata: func() -> plugin-metadata;
}
