package arclain:plugin;

interface host {
    // Logging
    enum log-level {
        trace,
        debug,
        info,
        warn,
        error
    }
    
    log: func(level: log-level, message: string);
    log-network-activity: func(message: string);
    
    // Settings
    get-setting: func(key: string) -> option<string>;
    set-setting: func(key: string, value: string);

    // HTTP
    http-get: func(url: string) -> result<string, string>;
    http-post: func(url: string, body: string) -> result<string, string>;

    // File I/O
    file-read: func(archive: string, file: string) -> result<string, string>;
    file-write: func(archive: string, file: string, data: string) -> result<string, string>;

    // Archive Context
    record archive-info {
        path: string,
        filename: string,
    }
    current-archive-info: func() -> option<archive-info>;
    list-archive-files: func() -> result<list<string>, string>;

    // Metadata
    emit-metadata: func(metadata-json: string);

    // UI Feedback
    show-message: func(title: string, message: string);

    // Caching
    get-cached-metadata: func(id: string) -> option<string>;
    save-cached-metadata: func(id: string, json: string);
}

interface ui {
    // UI Types
    variant ui-element {
        label(label-config),
        button(button-config),
        text-input(text-input-config),
        checkbox(checkbox-config),
        radio-group(radio-group-config),
        slider(slider-config),
        dropdown(dropdown-config),
        separator,
        space(f32),
    }
    
    record label-config {
        text: string,
        bold: bool,
        size: option<f32>,
    }
    
    record button-config {
        id: string,
        label: string,
    }
    
    record text-input-config {
        id: string,
        label: string,
        value: string,
    }
    
    record checkbox-config {
        id: string,
        label: string,
        checked: bool,
    }

    record radio-group-config {
        id: string,
        label: string,
        options: list<string>,
        selected: string,
    }

    record slider-config {
        id: string,
        label: string,
        value: f32,
        min: f32,
        max: f32,
        step: option<f32>,
    }

    record dropdown-config {
        id: string,
        label: string,
        options: list<string>,
        selected: string,
    }
}

interface rules {
    record move-file-rule {
        pattern: string,
        target: string,
    }

    record move-rule {
        target-dir: string,
        use-date: bool,
        use-category: bool,
    }

    record plugin-rule-trigger {
        filename-pattern: option<string>,
        has-file: option<string>,
        extensions: option<list<string>>,
        min-size: option<u64>,
        max-size: option<u64>,
        metadata-source: option<string>,
    }

    record plugin-rule-actions {
        root-folder: option<string>,
        move-files: list<move-file-rule>,
        move-to: option<move-rule>,
        rename-pattern: option<string>,
        organize-content: bool,
        delete-original: bool,
        use-standard-layout: bool,
    }

    record plugin-rule-definition {
        name: string,
        category: string,
        description: option<string>,
        trigger: plugin-rule-trigger,
        actions: plugin-rule-actions,
    }
}

world plugin-world {
    import host;
    
    // Plugin exports
    export init: func();
    use rules.{plugin-rule-definition};
    export get-default-rules: func() -> list<plugin-rule-definition>;
    
    // UI exports
    use ui.{ui-element};
    export get-ui-layout: func(extension-point: string) -> list<ui-element>;
    export on-ui-event: func(id: string, value: option<string>);
}
