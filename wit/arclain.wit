package arclain:plugin;

interface host {
    // Logging
    enum log-level {
        trace,
        debug,
        info,
        warn,
        error
    }
    
    log: func(level: log-level, message: string);
    log-network-activity: func(message: string);
    
    // Settings
    get-setting: func(key: string) -> option<string>;
    set-setting: func(key: string, value: string);

    // === Data API (unified) ===
    // Plugin requests data, host handles resolution transparently.
    // Sources are tried in order (waterfall pattern).

    // Data source types
    enum data-source {
        metadata-cache,  // Structured metadata (SQLite)
        content-cache,   // Binary blobs (cacache)
        local-file,      // File system
        memory,          // In-memory ephemeral
        network,         // HTTP fetch
    }

    record data-request {
        key: string,                    // Unique identifier for this resource
        url: option<string>,            // Source URL (required if network in sources)
        resource-type: resource-type,
        product-id: option<string>,     // For organization
        sources: list<data-source>,     // Resolution chain (empty = default)
    }

    enum resource-type {
        image,
        json,
        binary,
    }

    enum data-status {
        pending,
        fetching,
        ready,
        failed,
        cached,  // Already had it
    }

    record data-result {
        status: data-status,
        data: option<list<u8>>,
        error: option<string>,
    }


    // Request data - host downloads async, caches transparently
    request-data: func(request: data-request) -> string;  // returns request-id

    // Poll for data status/result
    poll-data: func(request-id: string) -> data-result;

    // Check if data exists (in cache/storage)
    has-data: func(key: string) -> bool;

    // Get data from storage (no fetch, returns None if not cached)
    get-data: func(key: string) -> option<list<u8>>;

    // Fetch a URL through the host's data service and store it in
    // the appropriate cache, *without* returning the bytes to the
    // plugin. Designed for large blobs (videos, full archives) where
    // shipping the body across the WASM ABI boundary would waste
    // memory and copy work — the bytes never enter the plugin's
    // sandbox. Returns true on success, false on any failure.
    //
    // Equivalent to `request-data` + a discarded `poll-data`, but the
    // plugin doesn't pay for the cross-boundary copy. Storage is keyed
    // by `request.key`; subsequent `has-data` / `get-data` see the
    // cached entry the same way they would for `request-data`.
    fetch-to-cache: func(request: data-request) -> bool;

    // Read a cached blob and hand it to the OS default application.
    // Host writes the bytes to a temp file with the supplied
    // extension (e.g. "mp4", "webm"), then `open::that(path)` —
    // shells out to whatever the OS has registered for that file
    // type (mpv / VLC / system player on the user's setup).
    //
    // The bytes never enter the plugin's sandbox; the plugin only
    // needs to know the cache key and the desired extension.
    // Returns Err on missing cache entry, write failure, or shell
    // failure.
    play-cached-blob: func(key: string, extension: string) -> result<_, string>;

    // Invalidate cache entry (to force refetch from network)
    invalidate-cache: func(key: string) -> bool;



    // Archive Context
    record archive-info {
        path: string,
        filename: string,
    }
    current-archive-info: func() -> option<archive-info>;
    list-archive-files: func() -> result<list<string>, string>;

    /// Rename the currently open archive file
    /// Takes a new filename (not full path) and returns the new full path on success
    /// Requires ArchiveModify capability
    rename-archive: func(new-name: string) -> result<string, string>;

    // Metadata
    emit-metadata: func(metadata-json: string);

    // UI Feedback
    show-message: func(title: string, message: string);

    // Status bar message (for plugin to display selected entry, etc.)
    set-status-message: func(message: string);

    // Copy text to system clipboard
    copy-to-clipboard: func(text: string) -> bool;

    // Metadata Cache Management (for UI, not plugin data access)
    list-cached-entries: func() -> list<string>;
    
    // Batch metadata summary for fast list rendering
    record metadata-summary {
        id: string,
        title: option<string>,
        geo-blocked: bool,
    }
    get-metadata-summaries: func(ids: list<string>) -> list<metadata-summary>;

    // Get full product metadata from database
    // Priority: metadata.sqlite -> JSON cache -> HTML cache (host parses)
    // Returns ProductMetadata as JSON string, or None if not found anywhere
    get-product-metadata: func(product-id: string, source: string) -> option<string>;
    
    export-cache: func() -> result<string, string>;
    import-cache: func() -> result<string, string>;
    
    // File operations
    // Create a file in the host's temp directory
    // Returns the full path to the created file, or an error message
    create-file: func(filename: string, content: list<u8>) -> result<string, string>;
}

interface ui {
    // Button actions (declarative navigation)
    variant button-action {
        none,
        show-dialog(string),
        close-dialog,
        open-page(string),
        close-page,
        custom(string),
    }

    // UI Element configs
    record label-config {
        text: string,
        bold: bool,
        size: option<f32>,
    }

    // Section header for semantic title hierarchy (like h1-h4)
    record section-header-config {
        title: string,
        level: u32,                    // 1=largest (h1), 4=smallest (h4)
        description: option<string>,   // Optional subtitle/description
    }

    record button-config {
        id: string,
        label: string,
        action: option<button-action>,
    }
    
    record text-input-config {
        id: string,
        label: string,
        value: string,
        placeholder: option<string>,  // If set, renders as simple input with placeholder (no label title)
    }
    
    record checkbox-config {
        id: string,
        label: string,
        checked: bool,
    }

    record radio-group-config {
        id: string,
        label: string,
        options: list<string>,
        selected: string,
    }

    record slider-config {
        id: string,
        label: string,
        value: f32,
        min: f32,
        max: f32,
        step: option<f32>,
    }

    record dropdown-config {
        id: string,
        label: string,
        options: list<string>,
        selected: string,
    }

    // New: Image config
    record image-config {
        cache-key: option<string>,
        url: option<string>,
        max-height: option<f32>,
    }

    // Tabs for view switching
    record tabs-config {
        id: string,
        tabs: list<string>,
        selected: string,
    }

    // Single list item (card-like display)
    record list-item-config {
        id: string,
        title: string,
        subtitle: option<string>,
        badge: option<string>,
        image-key: option<string>,      // Cache key to lookup/store the image
        image-url: option<string>,      // URL to fetch if not in cache
        selected: bool,
        warning-icon: option<warning-icon>,  // Optional warning indicator
    }

    // Scrollable list container
    record list-container-config {
        id: string,
        items: list<list-item-config>,
        max-height: option<f32>,
        empty-message: option<string>,
    }

    // Loading indicator
    record loading-config {
        message: option<string>,
    }

    // Warning / Alert banner
    enum warning-icon {
        warning,
        globe-x,
    }

    record warning-config {
        icon: warning-icon,
        message: string,
    }

    // Tag chips for displaying tags as styled pills
    record tag-chips-config {
        tags: list<string>,
        max-display: option<u32>,  // Limit visible tags (show "+N more")
    }

    // Toolbar button for plugin pages
    record toolbar-button-config {
        id: string,
        label: string,
        icon: option<string>,      // Optional icon name
        primary: bool,             // Primary/accent styling
        spacer-before: bool,       // Add flexible space before this button
    }

    // Toolbar for plugin pages
    record toolbar-config {
        buttons: list<toolbar-button-config>,
    }

    // Carousel gallery with thumbnail strip
    record carousel-config {
        id: string,
        images: list<tuple<string, option<string>>>,  // (cache_key, optional_url)
        current-index: u32,
        max-height: option<f32>,
        thumbnail-height: option<f32>,
        enable-lightbox: bool,
    }

    // Key-value pair for metadata display
    record key-value-pair {
        key: string,
        value: string,
    }

    // Key-value list for displaying metadata in a two-column grid (label: value)
    record key-value-list-config {
        items: list<key-value-pair>,
        columns: option<u32>,  // Number of key-value pairs per row (default: 1)
    }

    // Metadata grid for displaying key-value metadata in card format (label above value)
    record metadata-grid-config {
        items: list<key-value-pair>,
        columns: option<u32>,  // Number of columns (default: auto-fit based on available width)
    }

    // UI Element variant (Leaf nodes and simple containers)
    variant ui-element {
        label(label-config),
        section-header(section-header-config),
        button(button-config),
        text-input(text-input-config),
        checkbox(checkbox-config),
        radio-group(radio-group-config),
        slider(slider-config),
        dropdown(dropdown-config),
        separator,
        space(f32),
        image(image-config),
        tabs(tabs-config),
        list-container(list-container-config),
        loading(loading-config),
        warning(warning-config),
        tag-chips(tag-chips-config),
        toolbar(toolbar-config),
        carousel(carousel-config),
        key-value-list(key-value-list-config),
        metadata-grid(metadata-grid-config),
        // Visually-grouped settings section. The plugin emits a `group-begin`
        // followed by ordinary elements, then `group-end`. The host wraps
        // everything between the markers in a Form/SettingsGroup container so
        // plugin-supplied panels match the rest of the app.
        group-begin(settings-group-header),
        group-end,
    }

    // Title + optional description for a settings group, paired with
    // group-begin. group-end has no payload.
    record settings-group-header {
        title: string,
        description: option<string>,
    }

    // Top-level layout structure
    record split-config {
        sidebar: list<ui-element>,
        content: list<ui-element>,
        sidebar-width: option<f32>,
    }

    variant plugin-layout {
        single(list<ui-element>),
        split(split-config),
    }

    // === Top Tab Registration ===
    // Plugins can register top-level tabs in the app

    // Badge configuration for tabs
    record badge-config {
        count: option<u32>,      // Numeric badge (e.g., "3")
        dot: bool,               // Just a dot indicator
        color: string,           // "red", "green", "blue"
    }

    // Top-level tab configuration
    record top-tab-config {
        id: string,              // Unique tab identifier
        label: string,           // Display label
        icon: string,            // Emoji or icon string
        badge: option<badge-config>,
        priority: u32,           // Lower = more left (0-100 reserved for host)
    }

    // Plugin actions (returned from on-ui-event)
    enum toast-level {
        info,
        success,
        warning,
        error,
    }

    record toast-config {
        message: string,
        level: toast-level,
    }

    record message-config {
        title: string,
        message: string,
    }

    record cache-request {
        key: string,
        url: string,
    }

    record element-update {
        id: string,
        value: string,
    }

    // Open lightbox with images
    record open-lightbox-config {
        images: list<tuple<string, option<string>>>,  // (cache_key, optional_url)
        start-index: u32,
        title: option<string>,
    }

    variant plugin-action {
        none,
        // Data actions
        emit-metadata(string),
        cache-content(cache-request),
        // Notification actions
        show-toast(toast-config),
        show-message(message-config),
        // UI update actions
        refresh-panel(string),
        update-element(element-update),
        // Navigation actions
        open-page(string),
        close-dialog,
        // Clipboard actions
        copy-to-clipboard(string),
        // Lightbox actions
        open-lightbox(open-lightbox-config),
        // Page display name (for breadcrumbs/title)
        set-page-display-name(string),
        // Request async background fetch (host handles on tokio runtime)
        // Format: "source:id" e.g. "dlsite:RJ123456"
        request-fetch(string),
    }
}

interface rules {
    record move-file-rule {
        pattern: string,
        target: string,
    }

    record move-rule {
        target-dir: string,
        use-date: bool,
        use-category: bool,
    }

    record plugin-rule-trigger {
        filename-pattern: option<string>,
        has-file: option<string>,
        extensions: option<list<string>>,
        min-size: option<u64>,
        max-size: option<u64>,
        metadata-source: option<string>,
    }

    record plugin-rule-actions {
        root-folder: option<string>,
        move-files: list<move-file-rule>,
        move-to: option<move-rule>,
        rename-pattern: option<string>,
        organize-content: bool,
        delete-original: bool,
        use-standard-layout: bool,
    }

    record plugin-rule-definition {
        name: string,
        category: string,
        description: option<string>,
        trigger: plugin-rule-trigger,
        actions: plugin-rule-actions,
    }
}

world plugin-world {
    import host;
    
    // Plugin exports
    export init: func();
    use rules.{plugin-rule-definition};
    export get-default-rules: func() -> list<plugin-rule-definition>;
    
    // UI exports
    use ui.{ui-element, plugin-action, top-tab-config, plugin-layout};
    export get-ui-layout: func(extension-point: string) -> plugin-layout;
    export on-ui-event: func(id: string, value: option<string>) -> list<plugin-action>;
    
    // Top Tab registration
    export get-top-tabs: func() -> list<top-tab-config>;
}
