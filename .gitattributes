# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Rust source files
*.rs text eol=lf
*.toml text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf

# Config files
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf

# Scripts
*.sh text eol=lf
*.ps1 text eol=lf
*.bat text eol=lf

# Web files
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf

# WIT files (WebAssembly Interface Types)
*.wit text eol=lf

# Lockfiles
Cargo.lock text eol=lf

# Binary files (no conversion)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.wasm binary
*.dll binary
*.exe binary
*.so binary
*.dylib binary
*.zip binary
*.tar binary
*.gz binary
*.7z binary
*.rar binary
