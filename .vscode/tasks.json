{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-plugins",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/build-plugins.bat",
            "windows": {
                "command": "${workspaceFolder}/scripts/build-plugins.bat"
            },
            "linux": {
                "command": "bash ${workspaceFolder}/scripts/build-plugins.sh"
            },
            "osx": {
                "command": "bash ${workspaceFolder}/scripts/build-plugins.sh"
            },
            "problemMatcher": ["$rustc"],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        },
        {
            "label": "build-plugin-dlsite",
            "type": "shell",
            "command": "cargo",
            "args": [
                "build",
                "--target",
                "wasm32-unknown-unknown",
                "--release",
                "--manifest-path",
                "${workspaceFolder}/plugins/dlsite-metadata/Cargo.toml"
            ],
            "problemMatcher": ["$rustc"],
            "group": "build"
        },
        {
            "label": "build-plugin-gstreamer",
            "type": "shell",
            "command": "cargo",
            "args": [
                "build",
                "--target",
                "wasm32-unknown-unknown",
                "--release",
                "--manifest-path",
                "${workspaceFolder}/plugins/gstreamer-preview/Cargo.toml"
            ],
            "problemMatcher": ["$rustc"],
            "group": "build"
        },
        {
            "label": "build",
            "type": "cargo",
            "command": "build",
            "problemMatcher": ["$rustc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "test",
            "type": "cargo",
            "command": "test",
            "problemMatcher": ["$rustc"],
            "group": "test"
        }
    ]
}